---
// src/components/Itinerary.astro
---

<!-- Agregamos 'difuminar-bordes' y 'oculto-scroll' a la section principal -->
<section id="seccion-itinerario" class="w-full relative flex flex-col items-center justify-center px-6 py-20 bg-purple-50 difuminar-bordes oculto-scroll">

  <!-- FLORES DE FONDO -->
  <!--<img src="/Esquina2.png" alt="Decoración floral" class="absolute top-0 left-0 w-32 opacity-60 z-0 pointer-events-none" />-->
  <img src="/Esquina1.png" alt="Decoración floral" class="absolute bottom-0 right-0 w-32 opacity-60 z-0 pointer-events-none " />

      <!-- Encabezado animado individualmente -->
    <div class="text-center mb-10 elemento-scroll oculto-scroll">
      <h2 class="titulo-itinerario">Programa</h2>

        <p class="fuente-textos text-2xl text-gray-600 leading-snug">
          Compartí con nosotros momentos inolvidables<br>
        
        </p>

    </div>

  <!-- TARJETA TRANSPARENTE (Efecto Glassmorphism) -->
  <div class="relative bg-white/15 backdrop-blur-md border border-white/0 shadow-2xl w-full max-w-sm sm:max-w-md p-10 sm:p-12 flex flex-col items-center  z-10">
    

    <!-- Contenedor de la Línea de Tiempo Centrada -->
    <div class="flex flex-col items-center w-full">
      
      <!-- ITEM 1: Recepción -->
      <div class="flex flex-col items-center text-center elemento-scroll oculto-scroll">
        <div class="circulo-icono mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 8v8M7 8v8M16 8v8M12 12v8m0 0h-3m3 0h3M9 4h6a2 2 0 012 2v2a2 2 0 01-2 2H9a2 2 0 01-2-2V6a2 2 0 012-2z"></path>
          </svg>
        </div>
        <span class="hora-evento">18:30 hrs</span>
        <h3 class="titulo-evento">Recepción</h3>
      </div>

      <!-- Línea conectora animada -->
      <div class="linea-conectora elemento-scroll oculto-scroll"></div>

      <!-- ITEM 2: Ceremonia -->
      <div class="flex flex-col items-center text-center elemento-scroll oculto-scroll">
        <div class="circulo-icono mb-3">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path>
          </svg>
        </div>
        <span class="hora-evento">19:30 hrs</span>
        <h3 class="titulo-evento">Ceremonia</h3>
      </div>

      <!-- Línea conectora animada -->
      <div class="linea-conectora elemento-scroll oculto-scroll"></div>

      <!-- ITEM 3: Caravana -->
      <div class="flex flex-col items-center text-center elemento-scroll oculto-scroll">
        <div class="circulo-icono mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 16a2 2 0 100-4 2 2 0 000 4zm8 0a2 2 0 100-4 2 2 0 000 4z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.36 9.28L16.5 6h-9l-1.86 3.28A2 2 0 004 11v6h2v-1h12v1h2v-6a2 2 0 00-1.64-1.72z"></path>
          </svg>
        </div>
        <span class="hora-evento">20:30 hrs</span>
        <h3 class="titulo-evento">Caravana</h3>
      </div>

      <!-- Línea conectora animada -->
      <div class="linea-conectora elemento-scroll oculto-scroll"></div>

      <!-- ITEM 4: Fiesta -->
      <div class="flex flex-col items-center text-center elemento-scroll oculto-scroll">
        <div class="circulo-icono mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
        <span class="hora-evento">21:30 hrs</span>
        <h3 class="titulo-evento">Fiesta</h3>
      </div>

    </div>
  </div>
</section>

<style>
  /* =========================================
     ESTILOS VISUALES - ITINERARIO
     ========================================= */

  .titulo-itinerario {
    font-family: 'Great Vibes', cursive; 
    font-size: 3rem;
    font-weight: 500;
    color: #4c1d95; 
    line-height: 1;
    margin-bottom: 0.5rem;
  }
    .fuente-textos {
    font-family: 'Cormorant Garamond';
  }

  .subtitulo-itinerario {
    font-family: 'Cormorant Garamond';
    font-size: 1rem;
    letter-spacing: 0.15em;
    color: #1b1d20; 
  }
  
  .linea-conectora {
    width: 1px;
    height: 3rem; 
    background-color: #9ca3af; 
    margin: 1rem 0; 
  }

  .circulo-icono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background-color: transparent; 
    color: #4b5563; 
  }

  .hora-evento {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #111827; 
  }

  /* TEXTOS DE LOS DETALLES (Derecha) */
  .titulo-evento {
    font-family: 'Cormorant Garamond';
    font-size: 1.6rem; 
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase; 
    color: #30006b;
    margin-bottom: 0.15rem;
  }

  /* EFECTO DE DIFUMINADO EN LOS BORDES */
  .difuminar-bordes {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  /* =========================================
     ANIMACIÓN DE ENTRADA GENERAL DE LA SECCIÓN
     ========================================= */
  #seccion-itinerario.oculto-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s ease-out, transform 4s cubic-bezier(0.35, 1, 0.5, 1);
  }

  #seccion-itinerario.visible-scroll {
    opacity: 1;
    transform: translateY(0);
  }

  /* =========================================
     ANIMACIÓN DE ENTRADA INDIVIDUAL
     ========================================= */
  .elemento-scroll.oculto-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 3s ease-out, transform 5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .elemento-scroll.visible-scroll {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Observador general para la sección del itinerario (para aplicar el difuminado/aparición)
  const observadorSeccion = new IntersectionObserver((entradas) => {
    entradas.forEach(entrada => {
      if (entrada.isIntersecting) {
        entrada.target.classList.add('visible-scroll');
        observadorSeccion.unobserve(entrada.target); 
      }
    });
  }, { threshold: 0.15 });

  const seccionItinerario = document.getElementById('seccion-itinerario');
  if (seccionItinerario) {
    observadorSeccion.observe(seccionItinerario);
  }

  // Observador para los elementos internos individuales
  const observadorItems = new IntersectionObserver((entradas) => {
    entradas.forEach(entrada => {
      if (entrada.isIntersecting) {
        entrada.target.classList.add('visible-scroll');
        observadorItems.unobserve(entrada.target); 
      }
    });
  }, { threshold: 0.2 });

  const itemsAnimados = document.querySelectorAll('.elemento-scroll');
  itemsAnimados.forEach(item => {
    observadorItems.observe(item);
  });
</script>