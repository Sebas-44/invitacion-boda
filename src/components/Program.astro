<style>
  /* =========================================
     ESTILOS VISUALES - ITINERARIO
     ========================================= */

  .titulo-itinerario {
    font-family: 'Great Vibes', cursive; 
    font-size: 3rem;
    font-weight: 500;
    color: #4c1d95; 
    line-height: 1;
    margin-bottom: 0.5rem;
  }
    .fuente-textos {
    font-family: 'Cormorant Garamond';
  }

  .subtitulo-itinerario {
    font-family: 'Cormorant Garamond';
    font-size: 1rem;
    letter-spacing: 0.15em;
    color: #1b1d20; 
  }
  
  .linea-conectora {
    width: 1px;
    height: 3rem; 
    background-color: #9ca3af; 
    margin: 1rem 0; 
  }

  .circulo-icono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background-color: transparent; 
    /* Cambié a color morado para que combine más con el texto */
    color: #4c1d95; 
  }

  .hora-evento {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #111827; 
  }

  /* TEXTOS DE LOS DETALLES (Derecha) */
  .titulo-evento {
    font-family: 'Cormorant Garamond';
    font-size: 1.6rem; 
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase; 
    color: #30006b;
    margin-bottom: 0.15rem;
  }

  /* EFECTO DE DIFUMINADO EN LOS BORDES */
  .difuminar-bordes {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  /* =========================================
     ANIMACIÓN DE ENTRADA GENERAL DE LA SECCIÓN
     ========================================= */
  #seccion-itinerario.oculto-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s ease-out, transform 4s cubic-bezier(0.35, 1, 0.5, 1);
  }

  #seccion-itinerario.visible-scroll {
    opacity: 1;
    transform: translateY(0);
  }

  /* =========================================
     ANIMACIÓN DE ENTRADA INDIVIDUAL
     ========================================= */
  .elemento-scroll.oculto-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 3s ease-out, transform 5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .elemento-scroll.visible-scroll {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Observador general para la sección del itinerario (para aplicar el difuminado/aparición)
  const observadorSeccion = new IntersectionObserver((entradas) => {
    entradas.forEach(entrada => {
      if (entrada.isIntersecting) {
        entrada.target.classList.add('visible-scroll');
        observadorSeccion.unobserve(entrada.target); 
      }
    });
  }, { threshold: 0.15 });

  const seccionItinerario = document.getElementById('seccion-itinerario');
  if (seccionItinerario) {
    observadorSeccion.observe(seccionItinerario);
  }

  // Observador para los elementos internos individuales
  const observadorItems = new IntersectionObserver((entradas) => {
    entradas.forEach(entrada => {
      if (entrada.isIntersecting) {
        entrada.target.classList.add('visible-scroll');
        observadorItems.unobserve(entrada.target); 
      }
    });
  }, { threshold: 0.2 });

  const itemsAnimados = document.querySelectorAll('.elemento-scroll');
  itemsAnimados.forEach(item => {
    observadorItems.observe(item);
  });
</script>