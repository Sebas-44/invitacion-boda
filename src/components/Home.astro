---
// src/components/Home.astro
---

<section class="relative w-full min-h-[85vh] flex flex-col items-center justify-start pt-25 text-center px-6 py-12 portada-fondo">
  
  <!-- Degradado inferior estructural -->
  <div class="absolute inset-x-0 bottom-0 h-48 degradado-transicion pointer-events-none"></div>
  <div class="particulas-viento"></div>
  <!-- Contenedor Principal Limpio (Sin los divs vacíos) -->
  <div class="relative z-10 flex flex-col items-center w-full max-w-md mx-auto">
    
  <!-- 1. Etiqueta superior (Aparece primero) -->
  <span class="etiqueta-superior animacion-entrada delay-1">
  ¡Nos casamos!
  </span>
  
  <!-- 2. Primer nombre (Agregado efecto hover y inline-block) -->
  <h1 class="nombre-principal animacion-entrada delay-2 inline-block hover:scale-105 transition-transform duration-700 cursor-default mb-4">Gonzalo</h1>
  
  <!-- 3. Unión (Agregado efecto hover) -->
  <h3 class="simbolo-union animacion-entrada delay-3 inline-block hover:scale-110 transition-transform duration-700 mb-10">&</h3>
  
  <!-- 4. Segundo nombre (Agregado efecto hover y inline-block) -->
  <h1 class="nombre-principal animacion-entrada delay-4 inline-block hover:scale-105 transition-transform duration-700 cursor-default ">Roxana</h1>

<!-- Divisor Botánico de Ramas -->
<!-- Divisor Floral de Acuarela (Agregado efecto hover) -->
<div class="flex items-center justify-center w-full max-w-[320px] mt-0.1 mb-6 animacion-entrada delay-5">
  <img 
    src="/alianzas.png" 
    alt="Detalle floral" 
    class="w-full h-auto drop-shadow-sm opacity-90 hover:scale-110 transition-transform duration-700"
  />
</div>
<p class="fecha-boda animacion-entrada delay-5">
  26 . 09 . 26
</p>

  </div>

  <!-- Indicador para hacer scroll -->
  <div class=" relative z-10 mt-16 flex flex-col items-center gap-2 indicador-scroll animate-bounce ">
    <span>Deslizá</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>

</section>

<style>
  /* =========================================
     ESTILOS VISUALES - PORTADA REFINADA
     ========================================= */

  .portada-fondo {
    background-image: url('/Fondocambio.jpg');
    background-size: cover;
    background-position: center;
  }

  .degradado-transicion {
    background: linear-gradient(to bottom, transparent, #ffffff);
  }

  /* TIPOGRAFÍAS Y COLORES */
  .etiqueta-superior {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    text-transform: uppercase; 
    letter-spacing: 0.15em;    
    font-weight:600;
    color: #3c3146; 
    margin-bottom: 0.8rem;
  }

.nombre-principal {
    font-family: 'Great Vibes';
    font-size: 6rem; 
    font-weight: 580;
    line-height: 1.2; 
    padding: 0.5rem 1rem; 
    
    /* Efecto de Oro Metálico */
    background: linear-gradient(to right, #9c7842, #d2a32c, #edd968, #b89053, #fdf5c9, #9c7842);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0px 4px 8px rgba(0, 0, 0, 0.04));
    /* La animación se movió a .animacion-entrada abajo para que no choque */
}

  .simbolo-union {
    font-family: 'Great Vibes', cursive;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1; 
    color: #d2a32c; 
    margin: -1.5rem 0; 
  }

  /* DIVISOR GRÁFICO */
  .linea-divisor {
    height: 1px;
    flex: 1 1 0%;
    background-color: rgba(192, 132, 252, 0.6); 
  }

  .rombo-divisor {
    width: 0.4rem;
    height: 0.4rem;
    transform: rotate(45deg);
    border: 1px solid #a855f7;
    background-color: rgba(233, 213, 255, 0.5);
  }

  .fecha-boda {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    text-transform: uppercase; 
    letter-spacing: 0.30em;    
    font-weight: 1000;
    color: #3c3146; 
  }

.particulas-viento {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  
  background-image: 
    radial-gradient(circle, rgba(205, 44, 210, 0.5) 1px, transparent 1px),
    radial-gradient(circle, rgba(135, 44, 210, 0.2) 2.5px, transparent 2.5px),
    radial-gradient(circle, rgba(88, 44, 210, 0.4) 1.5px, transparent 1.5px);
  
  background-size: 
    43px 43px,
    71px 71px,
    113px 113px;
    
  -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 100%);
  mask-image: radial-gradient(circle at center, black 40%, transparent 100%);
  
  animation: viento-caotico 30s linear infinite;
}

@keyframes viento-caotico {
  0% { 
    background-position: 
      0 0, 
      20px 30px, 
      50px 10px; 
  }
  100% { 
    background-position: 
      150px -200px,  
      100px -100px,  
      -50px -150px;  
  }
}

@keyframes viento-cinematico {
  0% { background-position: 0px 0px; }
  100% { background-position: 100px -100px; } 
}
  .indicador-scroll {
    font-family: 'Cormorant Garamond', serif;
    color: #4c1d95; 
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.25em; 
    font-weight: 600;
  }

  /* =========================================
   ANIMACIONES DE ENTRADA Y ORO (SOLUCIÓN)
   ========================================= */

@keyframes aparecer-desenfocado {
  0% {
    opacity: 0;
    filter: blur(12px);
    transform: translateY(15px); 
  }
  100% {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
}

@keyframes reflejo-oro {
  to { background-position: 200% center; }
}

.animacion-entrada {
  opacity: 0; 
  animation: aparecer-desenfocado 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

/* Acá le decimos al navegador que si es el nombre, haga LAS DOS animaciones juntas sin anularse */
.nombre-principal.animacion-entrada {
  animation: 
    aparecer-desenfocado 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards, 
    reflejo-oro 8s linear infinite;
}

/* Escalonamiento de tiempos para que aparezcan uno por uno */
.delay-1 { animation-delay: 0.3s; }
.delay-2 { animation-delay: 1.0s; }
.delay-3 { animation-delay: 1.5s; }
.delay-4 { animation-delay: 2.0s; }
.delay-5 { animation-delay: 2.8s; }

</style>
