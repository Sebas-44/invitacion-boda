<style>
  /* Clases de tipografía garantizadas para Astro */
  .fuente-titulos {
    font-family: 'Great Vibes', cursive; 
    font-size: 3rem;
    font-weight: 550;
    color: #360382; 
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .fuente-textos {
    font-family: 'Cormorant Garamond';
  }
  /* =========================================
     ANIMACIÓN DE SCROLL
     ========================================= */
  .oculto-scroll {
    opacity: 4;
    transform: translateY(40px);
    transition: opacity 4s ease-out, transform 4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .visible-scroll {
    opacity: 4;
    transform: translateY(0);
  }
</style>
<script>
// Observador para la tarjeta de ubicación
  const observadorUbicacion = new IntersectionObserver((entradas) => {
    entradas.forEach(entrada => {
      // Cuando la sección entra en la pantalla
      if (entrada.isIntersecting) {
        entrada.target.classList.add('visible-scroll');
        // Dejamos de observar para que no se repita al subir y bajar
        observadorUbicacion.unobserve(entrada.target); 
      }
    });
  }, {
    threshold: 0.15 // Se activa cuando asoma un 15%
  });

  // Buscamos la sección y la observamos
  const seccionUbicacion = document.getElementById('seccion-ubicacion');
  if (seccionUbicacion) {
    observadorUbicacion.observe(seccionUbicacion);
  }
</script>