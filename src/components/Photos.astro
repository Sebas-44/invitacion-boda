---
// src/components/Photos.astro
---

<section id="seccion-fotos" class="w-full relative flex flex-col items-center justify-center px-6 py-20 bg-transparent">

  <!-- FLORES DE FONDO -->
  <img src="/Esquina2.png" alt="Decoración floral" class="absolute top-0 left-0 w-32 opacity-60 z-0 pointer-events-none" />
  <img src="/Esquina1.png" alt="Decoración floral" class="absolute bottom-0 right-0 w-32 opacity-60 z-0 pointer-events-none " />

<!-- TARJETA FRONTAL (SOLO TEXTOS) -->
  <div class="relative bg-white/15 backdrop-blur-md border border-white/0 shadow-2xl w-full max-w-sm sm:max-w-md p-8 flex flex-col items-center rounded-2xl z-10 mb-10 elemento-scroll oculto-scroll">
    
    <!-- Título -->
    <h2 class="fuente-titulos text-center mb-2.5">
      Nuestros momentos
    </h2>
    
    <!-- Versículo Bíblico -->
    <!-- leading-tight: junta las líneas | italic: cursiva elegante | text-gray-800: oscurece para dar grosor -->
    <p class="fuente-textos text-center font-bold italic leading-tight text-gray-600 sm:px-2">
      "Alguien que está solo puede ser atacado y vencido, 
      pero si son dos, se ponen de espalda con espalda y vencen; 
      mejor todavía si son tres, porque una cuerda triple no se corta fácilmente."
    </p>
    
    <!-- Referencia del Versículo -->
    <!-- tracking-widest: separa las letras | text-sm: achica un poco el tamaño -->
    <p class="fuente-textos2 uppercase text-center font-semibold mt-4 text-[#360382] tracking-widest">
      Eclesiastés 4:12 NTV
    </p>
    
  </div>

  <!-- GRILLA DE FOTOS -->
  <div class="grid grid-cols-2 gap-4 w-full max-w-sm sm:max-w-md z-10 elemento-scroll oculto-scroll">
    
    <!-- Foto Principal Vertical (Ocupa las 2 columnas, con aspecto vertical 4/5) -->
    <div class="contenedor-foto col-span-2 aspect-[4/5] sm:aspect-[3/4]">
      <img src="Foto4.jpeg" alt="Foto principal de los novios" class="imagen-galeria foto-vertical" />
    </div>

    <!-- Foto 2: Izquierda -->
    <div class="contenedor-foto aspect-square">
      <img src="Foto1.jpeg" alt="Momento especial" class="imagen-galeria" />
    </div>

    <!-- Foto 3: Derecha -->
    <div class="contenedor-foto aspect-square">
      <img src="Foto3.jpeg" alt="Momento divertido" class="imagen-galeria" />
    </div>

  </div>
</section>

<style>
  /* Tipografías */
  .fuente-titulos {
    font-family: 'Great Vibes', cursive; 
    font-size: 3.8rem; 
    font-weight: 500;
    color: #360382; 
    line-height: 1;
  }

  .fuente-textos {
    font-family: 'Cormorant Garamond', serif;
      font-size: 1.25rem; 
 
  }
    .fuente-textos2 {
    font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem; 
 
  }

  /* Estilos centralizados para las fotos */
  .contenedor-foto {
    width: 100%;
    overflow: hidden;
    border-radius: 1rem; /* rounded-2xl */
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); /* shadow-lg */
    border: 2px solid rgba(255, 255, 255, 0.8);
  }

  .imagen-galeria {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  /* NUEVO: Fuerza el recorte hacia la parte superior para fotos verticales */
  .foto-vertical {
    object-position: top;
  }

  .imagen-galeria:hover {
    transform: scale(1.05);
  }

  /* Animación de entrada */
  .oculto-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1.5s ease-out, transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .visible-scroll {
    opacity: 1; 
    transform: translateY(0);
  }
</style>

<script>
  const observadorFotos = new IntersectionObserver((entradas) => {
    entradas.forEach(entrada => {
      if (entrada.isIntersecting) {
        entrada.target.classList.add('visible-scroll');
        observadorFotos.unobserve(entrada.target); 
      }
    });
  }, { threshold: 0.15 });

  const elementos = document.querySelectorAll('#seccion-fotos .elemento-scroll');
  elementos.forEach(el => {
    observadorFotos.observe(el);
  });
</script>