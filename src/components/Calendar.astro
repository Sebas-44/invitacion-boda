---
// src/components/Calendar.astro

// Datos configurables del evento
const title = encodeURIComponent("Boda de Gonzalo & ...");
const details = encodeURIComponent("¡Acompañanos a celebrar nuestra boda!");
const location = encodeURIComponent("Lugar del Evento");

// Formato de fechas para Google Calendar (YYYYMMDDTHHmmss)
// 28 de Agosto de 2026 de 18:00 a 04:00 del día siguiente
const startIso = "20260828T180000";
const endIso = "20260829T040000";

const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${startIso}/${endIso}&details=${details}&location=${location}`;

// Días de la semana
const weekDays = ["L", "M", "M", "J", "V", "S", "D"];

// Agosto 2026 empieza en Sábado (índice 6, por lo que van 5 espacios vacíos antes del 1)
const emptyDays = Array.from({ length: 5 });
const daysInMonth = Array.from({ length: 31 }, (_, i) => i + 1);
const weddingDay = 28;
---

<section class="flex flex-col items-center justify-center text-center px-4 py-4 w-full">
  
  <span class="text-xs sm:text-sm font-semibold tracking-[0.25em] text-purple-800 uppercase mb-2">
    Guardá la fecha
  </span>

  <h2 class="font-serif text-2xl sm:text-3xl text-gray-900 mb-6 font-normal">
    Agosto 2026
  </h2>

  <!-- Tarjeta del Calendario -->
  <div class="w-full max-w-xs bg-purple-50/70 border border-purple-200/80 rounded-3xl p-6 shadow-sm">
    
    <!-- Días de la semana -->
    <div class="grid grid-cols-7 gap-1 mb-3 text-xs font-semibold text-purple-900/60">
      {weekDays.map((day) => (
        <span class="py-1">{day}</span>
      ))}
    </div>

    <!-- Grilla de números del mes -->
    <div class="grid grid-cols-7 gap-y-2 gap-x-1 text-sm">
      {emptyDays.map(() => (
        <div></div>
      ))}

      {daysInMonth.map((day) => (
        <div class="flex items-center justify-center h-8">
          {day === weddingDay ? (
            <span class="w-8 h-8 flex items-center justify-center bg-purple-700 text-white font-bold rounded-full shadow-md scale-110">
              {day}
            </span>
          ) : (
            <span class="text-gray-700 font-light">{day}</span>
          )}
        </div>
      ))}
    </div>

  </div>

  <!-- Botón para agendar en Google Calendar -->
  <a
    href={googleCalendarUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex items-center justify-center gap-2 bg-purple-900 hover:bg-purple-800 text-white text-sm font-medium py-3 px-6 rounded-full shadow-md transition-all hover:scale-105 active:scale-95"
  >
    <!-- Ícono de calendario -->
    <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    Agendar en Google Calendar
  </a>

</section>