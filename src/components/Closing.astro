---
// src/components/Closing.astro
---

<section id="seccion-cierre" class="w-full relative flex flex-col items-center justify-center px-6 py-24 bg-transparent overflow-hidden min-h-[60vh]">
  
  <!-- NUEVA IMAGEN DE FONDO INFERIOR -->
  <!-- Reemplazá "/fondo-cierre.png" por tu imagen real -->
  <img 
    src="/Fondocambio.jpg" 
    alt="Fondo floral decorativo" 
    class="absolute bottom-0 left-0 w-full h-auto max-h-[50vh] object-cover object-bottom opacity-60 z-0 pointer-events-none" 
  />

  <!-- Contenedor Principal (z-10 para estar por encima del fondo) -->
  <div class="flex flex-col items-center justify-center z-10 w-full max-w-lg text-center elemento-scroll oculto-scroll">

    <!-- Mensaje de invitación -->
    <p class="mensaje-esperamos">
      ¡Te esperamos!
    </p>

    <!-- Nombres de los novios con el efecto dorado exacto del Home -->
    <div class="flex flex-col items-center justify-center mb-6">
      <h2 class="nombre-oro" mb-6 >Gonzalo</h2>
      <span class="simbolo-union">&</span>
      <h2 class="nombre-oro">Roxana</h2>
    </div>

    <!-- Imagen floral / Anillos de cierre -->
    <div class="w-64 md:w-80 mt-2 mb-16">
      <img 
        src="/alianzas.png" 
        alt="Decoración de cierre floral" 
        class="w-full h-auto drop-shadow-sm opacity-90 hover:scale-105 transition-transform duration-700" 
      />
    </div>

  </div>

  <!-- Footer / Créditos (z-10 para que los enlaces funcionen) -->
  <div class="absolute bottom-6 text-center w-full z-10 elemento-scroll oculto-scroll retraso-footer">
    <p class="fuente-footer text-gray-600 italic font-medium">
      Diseñado con <span class="text-[#b89053]">♥</span> por <a href="https://instagram.com/tu_usuario" target="_blank" class="hover:text-[#4c1d95] transition-colors drop-shadow-sm">@tuinstagram</a>
    </p>
  </div>

</section>

<style>
  /* =========================================
     ESTILOS EXTRAÍDOS DEL HOME
     ========================================= */

  .mensaje-esperamos {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.2rem;
    font-style: italic;
    color: #3c3146; 
    margin-bottom: 1rem;
  }

  .nombre-oro {
    font-family: 'Great Vibes', cursive;
    font-size: 5.5rem; 
    font-weight: 580;
    line-height: 1.1; 
    padding: 0.5rem 1rem;
    margin: 0;

    /* Efecto de Oro Metálico */
    background: linear-gradient(to right, #9c7842, #d2a32c, #edd968, #b89053, #fdf5c9, #9c7842);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: reflejo-oro 8s linear infinite;
    filter: drop-shadow(0px 4px 8px rgba(0, 0, 0, 0.04));
  }

  .simbolo-union {
    font-family: 'Great Vibes', cursive;
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1;
    color: #d2a32c; 
    margin: -1.5rem 0; 
  }

  .fuente-footer {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  @keyframes reflejo-oro {
    to { background-position: 200% center; }
  }

  /* =========================================
     ANIMACIÓN DE ENTRADA AL SCROLLEAR
     ========================================= */
  .oculto-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 4s ease-out, transform 4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .visible-scroll {
    opacity: 1; 
    transform: translateY(0);
  }
  
  .retraso-footer {
    transition-delay: 0.3s;
  }

  /* Ajustes responsivos para celulares pequeños */
  @media (max-width: 400px) {
    .nombre-oro {
      font-size: 4.5rem;
    }
    .mensaje-esperamos {
      font-size: 1.8rem;
    }
  }
</style>

<script>
  const observadorCierre = new IntersectionObserver((entradas) => {
    entradas.forEach(entrada => {
      if (entrada.isIntersecting) {
        entrada.target.classList.add('visible-scroll');
        observadorCierre.unobserve(entrada.target); 
      }
    });
  }, { threshold: 0.15 });

  const elementosCierre = document.querySelectorAll('#seccion-cierre .elemento-scroll');
  elementosCierre.forEach(el => {
    observadorCierre.observe(el);
  });
</script>