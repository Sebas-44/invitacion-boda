---
// src/components/Closing.astro
---

<section class="flex flex-col items-center justify-center w-full px-4 pt-16 pb-8 text-center relative overflow-hidden bg-white/40">
  
  <!-- Si tenés una imagen de acuarela con hojas como en la foto, podés ponerla acá como fondo absoluto -->
  
  <div class="relative z-10 flex flex-col items-center w-full max-w-md mx-auto mt-8">
    
    <!-- Texto superior -->
    <h2 class="texto-esperamos mb-4">
      ¡Te esperamos!
    </h2>

    <!-- Nombres -->
    <h1 class="nombres-finales mb-12">
      Nombre <span class="simbolo-y">y</span> Nombre  
    </h1>

    <!-- Ilustración del autito (SVG o Imagen) -->
    <!-- Si tenés la imagen exacta, borrá el <svg> y usá: <img src="/auto-boda.png" class="w-40 h-auto opacity-90" alt="Auto de boda" /> -->
    <div class="ilustracion-auto mb-20 text-purple-800/60">
      <svg class="w-32 h-32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 16h14"></path>
        <path d="M4 16c0-1.5 1-3 3-3h10c2 0 3 1.5 3 3v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2z"></path>
        <path d="M5.5 13L7 9a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2l1.5 4"></path>
        <circle cx="8" cy="18" r="2"></circle>
        <circle cx="16" cy="18" r="2"></circle>
        <path d="M12 13v3"></path>
        <path d="M10 14h4"></path>
        <path d="M9 6c0-1 1-2 3-2s3 1 3 2"></path>
      </svg>
    </div>
  </div>

  <!-- Footer / Firma -->
  <div class="footer-firma flex items-center justify-center gap-2 mt-auto pt-10 w-full relative z-10">
    <span>Diseñado con</span>
    
    <!-- Ícono de corazón -->
    <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
    </svg>

    <!-- Link a tu red social o agencia -->
    <a href="https://instagram.com/tu_usuario" target="_blank" rel="noopener noreferrer" class="link-firma">
      @instragram
    </a>
  </div>

</section>

<style>
  /* =========================================
     ESTILOS VISUALES - CIERRE Y FIRMA
     ========================================= */

  .texto-esperamos {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.25rem;
    font-style: italic;
    color: #581c87; /* Morado oscuro */
  }

  .nombres-finales {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.5rem;
    font-weight: 400;
    color: #6b21a8; /* Morado base */
    line-height: 1.1;
  }

  .simbolo-y {
    font-size: 2.5rem;
    font-style: italic;
    font-weight: 300;
    color: #a855f7; /* Morado un poco más claro para contraste */
  }

  .ilustracion-auto {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* ESTILOS DEL PIE DE PÁGINA */
  .footer-firma {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.95rem;
    font-style: italic;
    color: #4b5563; /* Gris oscuro para no robar protagonismo */
  }

  .link-firma {
    color: #4b5563;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-firma:hover {
    color: #6b21a8; /* Se pinta de morado al pasar el mouse */
  }
</style>